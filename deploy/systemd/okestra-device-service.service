[Unit]
Description=Okestra remote Android device service
Documentation=https://github.com/jonace-mpelule/okestra-device
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=okestra-device
Group=okestra-device
EnvironmentFile=/etc/okestra-device/okestra-device.env
ExecStart=/usr/local/bin/okestra-device-service
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/okestra-device
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
